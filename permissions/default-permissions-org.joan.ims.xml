<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-grant the one RUNTIME permission joan needs.

     privapp-permissions (org.joan.ims.xml) cannot do this. That file
     allowlists signature|privileged permissions, and a dangerous runtime
     permission is neither granted nor required to be listed there ; an
     entry for one is simply never consulted.

     ACCESS_FINE_LOCATION is needed only by getAllCellInfo, which has
     required it since API 29, and only so P-Access-Network-Info can
     carry utran-cell-id-3gpp as TS 24.229 7.2A.4 and every reference
     stack do. joan uses location for nothing else.

     fixed="false" so the user can revoke it; a revoked grant costs the
     cell id in one header and nothing else, and the state row says
     pani_cell=no-permission when that happens.

     UNVERIFIED on a handset: DefaultPermissionGrantPolicy applies these
     when it runs, and whether it re-runs for a package added to /system
     after the device was provisioned has not been tested here. If it
     does not, the fallback is one adb command and no root:
       adb shell pm grant org.joan.ims android.permission.ACCESS_FINE_LOCATION
-->
<exceptions>
    <exception package="org.joan.ims">
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_BACKGROUND_LOCATION" fixed="false"/>
    </exception>
</exceptions>
