# V30 workaround overlay for an unmodified Android 17 ImsStack.
# This is a LineageOS telephony property, not an ImsStack patch.
# The V30 tree sets it false for the old modem-IMS path; an app-side
# ImsService needs the framework incoming-call listener path.
ro.telephony.block_binder_thread_on_incoming_calls=true
