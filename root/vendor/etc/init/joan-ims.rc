# Open AP SIP UA. Domain netmgrd already has kernel xfrm (vendor policy).
# `ims` domain cannot create netlink_xfrm (CIL append is not in the loaded policy).
service vendor.joan-ims /vendor/bin/joan-ims register
    class late_start
    user root
    group radio inet system
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:netmgrd:s0

on property:sys.boot_completed=1
    start vendor.joan-ims
