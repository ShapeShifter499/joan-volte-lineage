// AP-side IMS for LG V30 (joan). Java ImsService only.
// SPDX-License-Identifier: Apache-2.0
//
// This is the ONLY Android.bp that builds the stack. Drop the whole repo
// in at vendor/lge/joan-ims/ and inherit joan-ims.mk from the device
// makefile; see upstream/README.md.
//
// There used to be a second copy under upstream/ carrying these same
// module names. Soong parses every Android.bp in the tree, so the two
// could not coexist -- a tree containing both fails on duplicate module
// names before any of it is built. The upstream/ copy also addressed its
// sources as "../ims-service", which Soong rejects for escaping the
// module directory. This file is that copy's design, at a path where it
// works.

android_app {
    name: "JoanIms",
    srcs: ["ims-service/src/**/*.java"],
    manifest: "ims-service/AndroidManifest.xml",

    // system_ext, and the privapp-permissions prebuilt below must follow
    // it. SystemConfig reads privapp allowlists per partition and applies
    // them only to apps on that same partition, so an app on /system_ext
    // whose allowlist sits in /system/etc/permissions does not get its
    // privileged permissions -- which on a user build is fatal at boot.
    system_ext_specific: true,

    // Needs BIND_IMS_SERVICE and the privileged phone-state permissions,
    // so it must be privileged and platform-signed.
    privileged: true,
    certificate: "platform",
    platform_apis: true,

    required: ["privapp-permissions-org.joan.ims.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-org.joan.ims.xml",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "permissions/org.joan.ims.xml",
    filename_from_src: true,
}

// The device-default ImsService pointer, as a runtime resource overlay.
//
// This is the same apk the flashable zip installs to /product/overlay. It
// replaces a PRODUCT_PACKAGE_OVERLAYS directory that carried the identical
// string: a build-time overlay cannot be shipped in a zip, and keeping both
// meant two sources of truth for one resource. An RRO serves both paths, and
// build-time overlays are the legacy mechanism -- they cannot cross a
// Treble system/vendor split, which an RRO can.
runtime_resource_overlay {
    name: "JoanImsPhoneDefault",
    manifest: "rro/AndroidManifest.xml",
    resource_dirs: ["rro/res"],
    certificate: "platform",
    product_specific: true,
}

// NOT built here: the native user agent under native/.
//
// It was the original out-of-tree UA and is superseded by the Java
// ImsService above. The flashable zip does not ship it, and
// scripts/update-binary actively removes /system/bin/joan-ims-ua as a
// stale leftover -- so building it in-tree installed a daemon our own
// installer deletes. The sources stay in the repo as history; they are
// deliberately not wired into any ROM build.
