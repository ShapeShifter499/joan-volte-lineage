#!/sbin/sh
# joan-volte cleanup-only installer (v1).
# Removes ALL joan-ims artifacts (legacy /vendor layout and current
# /system layout) so the next official flash starts clean. Never fails
# on absent files; best-effort on mounts. Flash this BEFORE the official
# joan-volte-recovery.zip when migrating from a vendor-layout install.
OUTFD="/proc/self/fd/$2"

ui_print() {
  echo "ui_print $1" > "$OUTFD"
  echo "ui_print" > "$OUTFD"
}

ui_print "joan-volte cleanup: removing old installs"

# /system artifacts
mount -o rw,remount / 2>/dev/null || true
rm -f /system/bin/joan-ims /system/etc/init/joan-ims.rc
ui_print "  /system: joan-ims bin+rc removed (or absent)"

# /vendor artifacts (legacy layout). Mount is best-effort on dynamic
# partitions; if it fails we report and continue — the official zip
# retries this cleanup itself.
VENDOR_DEV=""
for d in /dev/block/mapper/vendor /dev/block/mapper/vendor_a \
         /dev/block/by-name/vendor /dev/block/bootdevice/by-name/vendor; do
  if [ -b "$d" ]; then VENDOR_DEV="$d"; break; fi
done
if [ -n "$VENDOR_DEV" ]; then
  mkdir -p /vendor
  umount -l /vendor 2>/dev/null || true
  if mount -o rw -t ext4 "$VENDOR_DEV" /vendor 2>/dev/null || \
     mount -o rw "$VENDOR_DEV" /vendor 2>/dev/null; then
    rm -f /vendor/bin/joan-ims /vendor/etc/init/joan-ims.rc
    ui_print "  /vendor: joan-ims bin+rc removed (or absent)"
  else
    ui_print "  WARN: /vendor mount failed — legacy files may remain"
  fi
else
  ui_print "  WARN: no vendor block device found"
fi

sync
ui_print "Cleanup done. Sideload joan-volte-recovery.zip next."
exit 0
