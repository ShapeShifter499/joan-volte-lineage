#!/sbin/sh
# Lineage recovery installer — joan-volte (no Magisk, no CIL append).
#
# v6: SAR/verity-safe. On system-as-root devices (all joan variants),
# /system is a read-only dm-verity logical partition. A blind
# "mount -o rw,remount /" fails in recovery and v5's writes then landed
# in the recovery ramdisk: exit 0, "Install completed", nothing installed
# after reboot (observed on H932 2026-08-29, cache/recovery/last_log).
# v6 verifies every write landed on the real block device and errors
# loudly instead.
OUTFD="/proc/self/fd/$2"
ZIP="$3"
TMP=/tmp/joan-volte

ui_print() {
  echo "ui_print $1" > "$OUTFD"
  echo "ui_print" > "$OUTFD"
}

error() {
  ui_print "ERROR: $1"
  # Recovery shows the error; the flash genuinely failed.
  exit 1
}

need_file() {
  f="$1"
  min="$2"
  [ -f "$f" ] || error "missing $f"
  sz=$(wc -c < "$f" | tr -d ' ')
  ui_print "  $(basename $f) ($sz bytes)"
  [ "$sz" -ge "$min" ] || error "$(basename $f) too small ($sz)"
}

copy_file() {
  src="$1"
  dst="$2"
  mode="$3"
  con="$4"
  mkdir -p "$(dirname "$dst")"
  cat "$src" > "$dst" || error "write $dst"
  chmod "$mode" "$dst"
  sz1=$(wc -c < "$src" | tr -d ' ')
  sz2=$(wc -c < "$dst" | tr -d ' ')
  [ "$sz1" = "$sz2" ] || error "size mismatch $dst ($sz2 != $sz1)"
  # Read-back proof: a ramdisk/failed mount can accept a write and a
  # size check but serve different bytes. Compare the actual content.
  if ! cmp -s "$src" "$dst"; then
    error "readback mismatch $dst (wrote to wrong filesystem?)"
  fi
  chcon "$con" "$dst" 2>/dev/null || true
}

ui_print "joan-volte v6: ImsService apk (SAR/verity-safe installer)"

rm -rf "$TMP"
mkdir -p "$TMP"
unzip -o "$ZIP" -d "$TMP" || error "unzip failed"

need_file "$TMP/app/joan-ims.apk" 5000

# --- Mount verification -------------------------------------------------
# The real /system must be a mounted block device (dm-*, e.g. dm-0),
# NOT the recovery ramdisk rootfs. After remount, a write test must
# succeed and read back identically.
ui_print "Mounting system rw"
mount -o rw,remount / 2>/dev/null || true
mount -o rw,remount /system 2>/dev/null || true
mount -o rw,remount /system/priv-app 2>/dev/null || true

SYSDM=$(stat -c %d /system/priv-app 2>/dev/null)
ROOTDM=$(stat -c %d / 2>/dev/null)
ui_print "  system st_dev=$SYSDM root st_dev=$ROOTDM"
if [ "$SYSDM" != "$ROOTDM" ]; then
  error "/system is not on the root device (SAR); refusing to write"
fi

# Write test on the actual target filesystem.
WT=/system/priv-app/.joan_write_test
if echo joan > "$WT" 2>/dev/null; then
  got=$(cat "$WT" 2>/dev/null)
  rm -f "$WT"
  [ "$got" = "joan" ] || error "write test failed readback on /system"
else
  error "/system is read-only (verity). Flash with adb remount deploy instead"
fi

mkdir -p /system/priv-app/JoanIms
chmod 755 /system/priv-app/JoanIms 2>/dev/null || true

ui_print "Removing joan-ims loopback listener"
rm -f /system/bin/joan-ims /system/bin/joan-ims-ua \
      /system/etc/init/joan-ims.rc /system/etc/init/joan-imsd.rc
rm -f /system_ext/bin/joan-ims-ua /system_ext/etc/init/joan-ims.rc

ui_print "Installing ImsService priv-app"
copy_file "$TMP/app/joan-ims.apk" /system/priv-app/JoanIms/JoanIms.apk 644 u:object_r:system_file:s0
if [ -f "$TMP/etc/permissions/org.joan.ims.xml" ]; then
  copy_file "$TMP/etc/permissions/org.joan.ims.xml" \
    /system/etc/permissions/org.joan.ims.xml 644 u:object_r:system_file:s0
fi
if [ -f "$TMP/etc/permissions/android.hardware.telephony.ims.xml" ]; then
  copy_file "$TMP/etc/permissions/android.hardware.telephony.ims.xml" \
    /system/etc/permissions/android.hardware.telephony.ims.xml 644 u:object_r:system_file:s0
fi

# --- RRO: device-default ImsService in com.android.phone ----------------
# Without this the ImsResolver classifies JoanIms as a carrier-style
# service with no features and never binds it (features: [], NO_IMS_...
# SERVICE_CONFIGURED). The overlay sets config_ims_mmtel_package so the
# resolver treats it as the device default and reads manifest metadata.
if [ -f "$TMP/app/joan-ims-rro.apk" ]; then
  ui_print "Installing com.android.phone overlay (device-default IMS)"
  mkdir -p /product/overlay
  mount -o rw,remount /product 2>/dev/null || true
  copy_file "$TMP/app/joan-ims-rro.apk" \
    /product/overlay/JoanImsPhoneDefault.apk 644 u:object_r:system_file:s0
fi

sync
ui_print "Done. Reboot system."
exit 0
