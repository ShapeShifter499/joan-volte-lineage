#!/sbin/sh
# Lineage recovery installer — joan-volte (no Magisk, no CIL append).
#
# v4: /system layout. The daemon + rc moved from /vendor to /system
# (/vendor is a zero-headroom logical partition on joan — recovery writes
# fail with "ERROR: write /vendor/bin/joan-ims"). SELinux binds by label,
# not path, so netmgrd_exec works identically on /system/bin.
# Also removes the legacy /vendor install if present (best-effort).
OUTFD="/proc/self/fd/$2"
ZIP="$3"
TMP=/tmp/joan-volte

ui_print() {
  echo "ui_print $1" > "$OUTFD"
  echo "ui_print" > "$OUTFD"
}

error() {
  ui_print "ERROR: $1"
  exit 1
}

need_file() {
  f="$1"
  min="$2"
  [ -f "$f" ] || error "missing $f"
  sz=$(wc -c < "$f" | tr -d ' ')
  ui_print "  $(basename $f) ($sz bytes)"
  [ "$sz" -ge "$min" ] || error "$(basename $f) too small ($sz)"
}

copy_file() {
  src="$1"
  dst="$2"
  mode="$3"
  con="$4"
  mkdir -p "$(dirname "$dst")"
  cat "$src" > "$dst" || error "write $dst"
  chmod "$mode" "$dst"
  sz1=$(wc -c < "$src" | tr -d ' ')
  sz2=$(wc -c < "$dst" | tr -d ' ')
  [ "$sz1" = "$sz2" ] || error "size mismatch $dst ($sz2 != $sz1)"
  chcon "$con" "$dst" 2>/dev/null || true
}

ui_print "joan-volte v4: joan-ims + ImsService apk (system layout)"

rm -rf "$TMP"
mkdir -p "$TMP"
unzip -o "$ZIP" -d "$TMP" || error "unzip failed"

need_file "$TMP/system/bin/joan-ims" 10000
need_file "$TMP/system/etc/init/joan-ims.rc" 80
need_file "$TMP/app/joan-ims.apk" 5000

ui_print "Mounting system rw"
mount -o rw,remount / 2>/dev/null || true
mkdir -p /system/priv-app/JoanIms
chmod 755 /system/priv-app/JoanIms 2>/dev/null || true

ui_print "Installing joan-ims-ua (netmgrd_exec label)"
copy_file "$TMP/system/bin/joan-ims" /system/bin/joan-ims-ua 755 u:object_r:netmgrd_exec:s0
copy_file "$TMP/system/etc/init/joan-ims.rc" /system/etc/init/joan-ims.rc 644 u:object_r:system_file:s0

ui_print "Installing ImsService priv-app"
copy_file "$TMP/app/joan-ims.apk" /system/priv-app/JoanIms/JoanIms.apk 644 u:object_r:system_file:s0
if [ -f "$TMP/etc/permissions/org.joan.ims.xml" ]; then
  copy_file "$TMP/etc/permissions/org.joan.ims.xml" \
    /system/etc/permissions/org.joan.ims.xml 644 u:object_r:system_file:s0
fi

# Best-effort removal of the legacy /vendor install (would double-start
# the daemon otherwise). Vendor mount in recovery is flaky on dynamic
# partitions, so never fail the install over this.
ui_print "Legacy /vendor cleanup (best-effort)"
if mount -o rw,remount /vendor 2>/dev/null; then
  rm -f /vendor/bin/joan-ims /vendor/etc/init/joan-ims.rc
  ui_print "  legacy vendor files removed (or absent)"
else
  ui_print "  WARN: vendor rw remount failed; flash cleanup zip first"
fi


sync
ui_print "Done. Reboot system."
exit 0
