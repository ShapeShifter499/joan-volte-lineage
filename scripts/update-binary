#!/sbin/sh
# Lineage recovery installer — joan-volte (no Magisk, no CIL append).
#
# v6: SAR/verity-safe. On system-as-root devices (all joan variants),
# /system is a read-only dm-verity logical partition. A blind
# "mount -o rw,remount /" fails in recovery and v5's writes then landed
# in the recovery ramdisk: exit 0, "Install completed", nothing installed
# after reboot (observed on H932 2026-08-29, cache/recovery/last_log).
# v6 verifies every write landed on the real block device and errors
# loudly instead.
OUTFD="/proc/self/fd/$2"
ZIP="$3"
TMP=/tmp/joan-volte

ui_print() {
  echo "ui_print $1" > "$OUTFD"
  echo "ui_print" > "$OUTFD"
}

error() {
  ui_print "ERROR: $1"
  # Recovery shows the error; the flash genuinely failed.
  exit 1
}

need_file() {
  f="$1"
  min="$2"
  [ -f "$f" ] || error "missing $f"
  sz=$(wc -c < "$f" | tr -d ' ')
  ui_print "  $(basename $f) ($sz bytes)"
  [ "$sz" -ge "$min" ] || error "$(basename $f) too small ($sz)"
}

copy_file() {
  src="$1"
  dst="$2"
  mode="$3"
  con="$4"
  mkdir -p "$(dirname "$dst")"
  cat "$src" > "$dst" || error "write $dst"
  chmod "$mode" "$dst"
  sz1=$(wc -c < "$src" | tr -d ' ')
  sz2=$(wc -c < "$dst" | tr -d ' ')
  [ "$sz1" = "$sz2" ] || error "size mismatch $dst ($sz2 != $sz1)"
  # Read-back proof: a ramdisk/failed mount can accept a write and a
  # size check but serve different bytes. Compare the actual content.
  if ! cmp -s "$src" "$dst"; then
    error "readback mismatch $dst (wrote to wrong filesystem?)"
  fi
  chcon "$con" "$dst" 2>/dev/null || true
}

ui_print "joan-volte v6: ImsService apk (SAR/verity-safe installer)"

rm -rf "$TMP"
mkdir -p "$TMP"
unzip -o "$ZIP" -d "$TMP" || error "unzip failed"

need_file "$TMP/app/joan-ims.apk" 5000

# --- Mount the real partitions -----------------------------------------
# Recovery does not mount /system or /product for a sideload on this
# device: in recovery / is the rootfs ramdisk and /system/priv-app does
# not exist at all. v5 wrote there anyway, into the ramdisk, and the
# files were gone at reboot -- "Install completed with status 0" and
# nothing installed. v6 refused, correctly, but could not install either.
#
# The partitions are logical (dynamic/super). Recovery creates them as
# /dev/block/mapper/<name>, and they mount read-write: dm-verity is not
# in the way on this build. Mount them ourselves at private mountpoints.
SYSMNT=/mnt/joan_system
PRODMNT=/mnt/joan_product
VENDMNT=/mnt/joan_vendor
TMPDM=$(stat -c %d /tmp 2>/dev/null)

mount_part() {
  name="$1"
  mp="$2"
  MP_RESULT="$mp"
  MP_OWNED=0
  mkdir -p "$mp"
  if mount | grep -q " $mp "; then
    MP_OWNED=1
  else
    for dev in /dev/block/mapper/$name /dev/block/by-name/$name; do
      [ -b "$dev" ] || continue
      real=$(readlink -f "$dev" 2>/dev/null)
      [ -n "$real" ] || real="$dev"
      # Recovery mounts /system itself, to read otacerts.zip while it
      # verifies the package signature. ext4 refuses a second rw mount of
      # a device it already holds read-only, so a plain "mount -o rw"
      # here failed with "cannot mount system" -- intermittently, since it
      # depends on whether recovery has let go by the time we run.
      # Observed on US998 2026-09-14: same zip, same state, sideload
      # failed while the identical run from a recovery shell succeeded.
      # Reuse recovery's mount rather than compete for the device.
      cur=$(mount | grep "^$real " | head -1 | sed "s/^[^ ]* on \\(.*\\) type .*/\\1/")
      if [ -n "$cur" ] && [ "$cur" != "/" ]; then
        mount -o rw,remount "$cur" 2>/dev/null || true
        MP_RESULT="$cur"
        ui_print "  $name is already mounted at $cur; reusing that mount"
        break
      fi
      if mount -o rw "$dev" "$mp" 2>/dev/null; then
        MP_OWNED=1
        break
      fi
    done
  fi
  mp="$MP_RESULT"
  mount | grep -q " $mp " || error "cannot mount $name (looked in /dev/block/mapper and by-name)"
  mount -o rw,remount "$mp" 2>/dev/null || true

  # It must not be the recovery ramdisk. /tmp is unambiguously the
  # ramdisk, so this needs no assumption about what / is on SAR.
  dm=$(stat -c %d "$mp" 2>/dev/null)
  ui_print "  $name st_dev=$dm tmp(ramdisk) st_dev=$TMPDM"
  if [ -z "$dm" ] || [ "$dm" = "$TMPDM" ]; then
    error "$name resolved to the recovery ramdisk; refusing to write"
  fi

  wt="$mp/.joan_write_test"
  if echo joan > "$wt" 2>/dev/null; then
    got=$(cat "$wt" 2>/dev/null)
    rm -f "$wt"
    [ "$got" = "joan" ] || error "$name failed write readback"
  else
    # Distinguish the two, because they need different answers and
    # guessing sent me chasing verity when /odm was simply full.
    # No awk in recovery -- this used to print nothing at all.
    free=$(df -k "$mp" 2>/dev/null | tail -1 | tr -s " " | cut -d" " -f4)
    if mount | grep " $mp " | grep -q "[(,]ro[,)]"; then
      error "$name is mounted read-only; cannot install"
    else
      error "$name is writable but the write failed (${free:-?} KB free); cannot install"
    fi
  fi
}

ui_print "Mounting system"
mount_part system "$SYSMNT"
SYSMNT="$MP_RESULT"; SYSMNT_OWNED="$MP_OWNED"
ui_print "Mounting product"
mount_part product "$PRODMNT"
PRODMNT="$MP_RESULT"; PRODMNT_OWNED="$MP_OWNED"
# vendor carries audio_effects.xml. It is mounted last and its absence is
# not fatal: everything else this zip installs lives on system and
# product, and a device whose vendor will not mount should still get a
# working IMS stack rather than a failed flash.
ui_print "Mounting vendor"
mount_part vendor "$VENDMNT" || true
VENDMNT="$MP_RESULT"; VENDMNT_OWNED="$MP_OWNED"

# system-as-root: the partition root is /, and the /system tree sits in
# a system/ subdirectory of it.
SYS="$SYSMNT/system"
[ -d "$SYS/priv-app" ] || error "$SYS/priv-app missing; unexpected system layout"

mkdir -p "$SYS/priv-app/JoanIms"
chmod 755 "$SYS/priv-app/JoanIms" 2>/dev/null || true

ui_print "Removing joan-ims loopback listener"
rm -f "$SYS/bin/joan-ims" "$SYS/bin/joan-ims-ua" \
      "$SYS/etc/init/joan-ims.rc" "$SYS/etc/init/joan-imsd.rc"
rm -f "$SYSMNT/system_ext/bin/joan-ims-ua" \
      "$SYSMNT/system_ext/etc/init/joan-ims.rc"

ui_print "Installing ImsService priv-app"
copy_file "$TMP/app/joan-ims.apk" "$SYS/priv-app/JoanIms/JoanIms.apk" 644 u:object_r:system_file:s0
if [ -f "$TMP/etc/permissions/org.joan.ims.xml" ]; then
  copy_file "$TMP/etc/permissions/org.joan.ims.xml" \
    "$SYS/etc/permissions/org.joan.ims.xml" 644 u:object_r:system_file:s0
fi
# The IMS feature declaration needs an ownership record, or uninstall
# cannot put the device back as it found it. A ROM that already declares
# android.hardware.telephony.ims must get ITS file back; a ROM that does
# not must end up with no file at all. Decide once, before the first
# overwrite, and leave a marker -- a re-flash must not re-decide, or it
# would back up our own copy as if it were the ROM's.
#
#   absent, or already byte-identical to ours -> .joan-added (remove on uninstall)
#   present and different                     -> .joan-orig  (restore on uninstall)
#   neither marker at uninstall time          -> leave it alone
#
# The byte-identical case also migrates installs from before this marker
# existed: their file is ours, so it is correctly claimed rather than
# mistaken for the ROM's.
IMSFEAT_SRC="$TMP/etc/permissions/android.hardware.telephony.ims.xml"
if [ -f "$IMSFEAT_SRC" ]; then
  IMSFEAT="$SYS/etc/permissions/android.hardware.telephony.ims.xml"
  IMSFEAT_BAK="$IMSFEAT.joan-orig"
  IMSFEAT_OWN="$IMSFEAT.joan-added"
  # Path as it reads on a booted system; $SYS is the recovery mountpoint
  # and would only confuse anyone trying to find the file later.
  IMSFEAT_SHOWN="/system/etc/permissions/android.hardware.telephony.ims.xml"
  if [ ! -f "$IMSFEAT_BAK" ] && [ ! -f "$IMSFEAT_OWN" ]; then
    if [ ! -f "$IMSFEAT" ] || cmp -s "$IMSFEAT" "$IMSFEAT_SRC"; then
      echo joan > "$IMSFEAT_OWN" || error "write $IMSFEAT_OWN"
      chmod 644 "$IMSFEAT_OWN"
      chcon u:object_r:system_file:s0 "$IMSFEAT_OWN" 2>/dev/null || true
      ui_print "  IMS feature xml: not present in this ROM, so it is ours."
      ui_print "    Marker: $IMSFEAT_SHOWN.joan-added"
      ui_print "    Uninstall will delete the xml and the marker."
    else
      copy_file "$IMSFEAT" "$IMSFEAT_BAK" 644 u:object_r:system_file:s0
      ui_print "  IMS feature xml: this ROM ships its own, kept a backup."
      ui_print "    Backup: $IMSFEAT_SHOWN.joan-orig"
      ui_print "    Uninstall restores it from there."
    fi
  fi
  copy_file "$IMSFEAT_SRC" "$IMSFEAT" 644 u:object_r:system_file:s0
fi

# --- RRO: device-default ImsService in com.android.phone ----------------
# Without this ImsResolver classifies JoanIms as a carrier-style service
# with no features and never binds it.
if [ -f "$TMP/app/joan-ims-rro.apk" ]; then
  ui_print "Installing com.android.phone overlay (device-default IMS)"
  mkdir -p "$PRODMNT/overlay"
  copy_file "$TMP/app/joan-ims-rro.apk" \
    "$PRODMNT/overlay/JoanImsPhoneDefault.apk" 644 u:object_r:system_file:s0
fi

# --- RRO: framework VoLTE admit (config_device_volte_available) ---------
# ImsManager.isVolteEnabledByPlatform() ANDs this framework-res bool with
# carrier_volte_available_bool and isGbaValid(). joan ships it false, so
# without this the Settings VoLTE toggle never renders and every outbound
# dial goes CS -- while REGISTER still succeeds and MT calls still arrive,
# which makes it look like a SIP bug. A ROM build should set this in the
# device tree instead; see upstream/VOLTE-PLATFORM-SETUP.md.
if [ -f "$TMP/app/joan-fw-volte.apk" ]; then
  ui_print "Installing framework overlay (VoLTE admit)"
  mkdir -p "$PRODMNT/overlay"
  copy_file "$TMP/app/joan-fw-volte.apk" \
    "$PRODMNT/overlay/JoanFwVolte.apk" 644 u:object_r:system_file:s0
fi

# --- Viettel 45204 APN overlay (merge, never replace) -------------------
# TelephonyProvider loads ONE conf file; product wins over system/oem.
# Copying the 4-row overlay over product/etc/apns-conf.xml would wipe
# every other carrier. Merge 45204 into the existing world list.
if [ -f "$TMP/apn/viettel-45204.xml" ] && [ -f "$TMP/scripts/merge-viettel-apns.sh" ]; then
  ui_print "Merging Viettel 45204 IMS/XCAP APNs into product apns-conf"
  ORIG="$PRODMNT/etc/apns-conf.xml"
  SYSORIG="$SYS/etc/apns-conf.xml"
  BACKUP="$PRODMNT/etc/apns-conf.xml.joan-orig"
  mkdir -p "$PRODMNT/etc"
  if [ ! -f "$ORIG" ]; then
    [ -f "$SYSORIG" ] || error "no apns-conf.xml on product or system; refusing overlay-only install"
    copy_file "$SYSORIG" "$ORIG" 644 u:object_r:system_file:s0
  fi
  if [ ! -f "$BACKUP" ]; then
    copy_file "$ORIG" "$BACKUP" 644 u:object_r:system_file:s0
    ui_print "  APN list: saved the ROM copy before merging."
    ui_print "    Backup: /product/etc/apns-conf.xml.joan-orig"
    ui_print "    Uninstall restores it from there."
  fi
  need_file "$BACKUP" 200
  MERGE_TMP="$TMP/viettel-apn-blocks"
  export MERGE_TMP
  sh "$TMP/scripts/merge-viettel-apns.sh" "$BACKUP" \
    "$TMP/apn/viettel-45204.xml" > "$TMP/apns-merged.xml" \
    || error "viettel APN merge failed"
  need_file "$TMP/apns-merged.xml" 200
  # Merged world list must be larger than the 4-row overlay.
  osz=$(wc -c < "$TMP/apn/viettel-45204.xml" | tr -d ' ')
  msz=$(wc -c < "$TMP/apns-merged.xml" | tr -d ' ')
  [ "$msz" -gt "$osz" ] || error "merged apns-conf.xml not larger than overlay ($msz <= $osz)"
  # These have to prove OUR rows landed, not that the file contains an
  # ims row somewhere: every world list already ships ims and xcap rows
  # for other carriers, so a bare grep for them passes even if the
  # Viettel block were dropped entirely. Check the marker the merge
  # writes, and that the block between the markers carries both rows.
  grep -q 'joan-viettel-45204-begin' "$TMP/apns-merged.xml" \
    || error "merged APN list has no joan Viettel block"
  sed -n '/joan-viettel-45204-begin/,/joan-viettel-45204-end/p' \
    "$TMP/apns-merged.xml" > "$TMP/apns-viettel-block.xml"
  grep -q 'apn="ims"' "$TMP/apns-viettel-block.xml" \
    || error "joan Viettel block missing ims"
  grep -q 'apn="xcap"' "$TMP/apns-viettel-block.xml" \
    || error "joan Viettel block missing xcap"
  # And exactly one Viettel internet row survived, in either MNC spelling.
  vnet=$(grep -c 'apn="v-internet"' "$TMP/apns-merged.xml" || true)
  [ "$vnet" = "1" ] \
    || error "merged APN list has $vnet Viettel internet rows, expected 1"
  copy_file "$TMP/apns-merged.xml" "$ORIG" 644 u:object_r:system_file:s0
fi

# --- AGC pre-processing effect (merge, never replace) -------------------
#
# joan ships libaudiopreprocessing.so but audio_effects.xml never
# declares it, so AutomaticGainControl.isAvailable() is false and the
# VoLTE uplink runs at whatever level the microphone gave us -- measured
# about 16 dB below the downlink on real calls. Only agc is added; aec
# and ns already come from Qualcomm's libqcomvoiceprocessing.so.
if [ -f "$TMP/scripts/merge-agc-effect.sh" ] && [ -d "$VENDMNT/etc" ]; then
  AE="$VENDMNT/etc/audio_effects.xml"
  AEBACK="$VENDMNT/etc/audio_effects.xml.joan-orig"
  if [ -f "$AE" ]; then
    ui_print "Adding the AGC audio effect (uplink level)"
    if [ ! -f "$AEBACK" ]; then
      copy_file "$AE" "$AEBACK" 644 u:object_r:vendor_configs_file:s0
      ui_print "  audio_effects.xml: saved the ROM copy before merging."
    fi
    if [ -f "$VENDMNT/lib64/soundfx/libaudiopreprocessing.so" ] \
       || [ -f "$VENDMNT/lib/soundfx/libaudiopreprocessing.so" ]; then
      sh "$TMP/scripts/merge-agc-effect.sh" "$AEBACK" \
        > "$TMP/audio_effects-merged.xml" || error "agc effect merge failed"
      need_file "$TMP/audio_effects-merged.xml" 200
      grep -q "libaudiopreprocessing.so" "$TMP/audio_effects-merged.xml" \
        || error "merged audio_effects.xml missing the pre_processing library"
      grep -q "<effect name=\"agc\"" "$TMP/audio_effects-merged.xml" \
        || error "merged audio_effects.xml missing the agc effect"
      copy_file "$TMP/audio_effects-merged.xml" "$AE" 644 \
        u:object_r:vendor_configs_file:s0
    else
      # Declaring an effect whose library is absent makes audioserver log
      # a load failure on every boot and gains nothing.
      ui_print "  libaudiopreprocessing.so not present; skipping AGC."
    fi
  fi
fi

sync
# Only unmount what we mounted. Tearing down recovery's own mount would
# pull the ground out from under it mid-install.
[ "$VENDMNT_OWNED" = "1" ] && umount "$VENDMNT" 2>/dev/null
[ "$PRODMNT_OWNED" = "1" ] && umount "$PRODMNT" 2>/dev/null
[ "$SYSMNT_OWNED" = "1" ] && umount "$SYSMNT" 2>/dev/null

sync
ui_print "Done. Reboot system."
exit 0
