#!/sbin/sh
# Lineage recovery installer — joan-volte (no Magisk, no CIL append).
#
# v6: SAR/verity-safe. On system-as-root devices (all joan variants),
# /system is a read-only dm-verity logical partition. A blind
# "mount -o rw,remount /" fails in recovery and v5's writes then landed
# in the recovery ramdisk: exit 0, "Install completed", nothing installed
# after reboot (observed on H932 2026-08-29, cache/recovery/last_log).
# v6 verifies every write landed on the real block device and errors
# loudly instead.
OUTFD="/proc/self/fd/$2"
ZIP="$3"
TMP=/tmp/joan-volte

ui_print() {
  echo "ui_print $1" > "$OUTFD"
  echo "ui_print" > "$OUTFD"
}

error() {
  ui_print "ERROR: $1"
  # Recovery shows the error; the flash genuinely failed.
  exit 1
}

need_file() {
  f="$1"
  min="$2"
  [ -f "$f" ] || error "missing $f"
  sz=$(wc -c < "$f" | tr -d ' ')
  ui_print "  $(basename $f) ($sz bytes)"
  [ "$sz" -ge "$min" ] || error "$(basename $f) too small ($sz)"
}

copy_file() {
  src="$1"
  dst="$2"
  mode="$3"
  con="$4"
  mkdir -p "$(dirname "$dst")"
  cat "$src" > "$dst" || error "write $dst"
  chmod "$mode" "$dst"
  sz1=$(wc -c < "$src" | tr -d ' ')
  sz2=$(wc -c < "$dst" | tr -d ' ')
  [ "$sz1" = "$sz2" ] || error "size mismatch $dst ($sz2 != $sz1)"
  # Read-back proof: a ramdisk/failed mount can accept a write and a
  # size check but serve different bytes. Compare the actual content.
  if ! cmp -s "$src" "$dst"; then
    error "readback mismatch $dst (wrote to wrong filesystem?)"
  fi
  chcon "$con" "$dst" 2>/dev/null || true
}

ui_print "joan-volte v6: ImsService apk (SAR/verity-safe installer)"

rm -rf "$TMP"
mkdir -p "$TMP"
unzip -o "$ZIP" -d "$TMP" || error "unzip failed"

need_file "$TMP/app/joan-ims.apk" 5000

# --- Mount the real partitions -----------------------------------------
# Recovery does not mount /system or /product for a sideload on this
# device: in recovery / is the rootfs ramdisk and /system/priv-app does
# not exist at all. v5 wrote there anyway, into the ramdisk, and the
# files were gone at reboot -- "Install completed with status 0" and
# nothing installed. v6 refused, correctly, but could not install either.
#
# The partitions are logical (dynamic/super). Recovery creates them as
# /dev/block/mapper/<name>, and they mount read-write: dm-verity is not
# in the way on this build. Mount them ourselves at private mountpoints.
SYSMNT=/mnt/joan_system
PRODMNT=/mnt/joan_product
TMPDM=$(stat -c %d /tmp 2>/dev/null)

mount_part() {
  name="$1"
  mp="$2"
  mkdir -p "$mp"
  if ! mount | grep -q " $mp "; then
    for dev in /dev/block/mapper/$name /dev/block/by-name/$name; do
      [ -b "$dev" ] || continue
      mount -o rw "$dev" "$mp" 2>/dev/null && break
    done
  fi
  mount | grep -q " $mp " || error "cannot mount $name (looked in /dev/block/mapper and by-name)"
  mount -o rw,remount "$mp" 2>/dev/null || true

  # It must not be the recovery ramdisk. /tmp is unambiguously the
  # ramdisk, so this needs no assumption about what / is on SAR.
  dm=$(stat -c %d "$mp" 2>/dev/null)
  ui_print "  $name st_dev=$dm tmp(ramdisk) st_dev=$TMPDM"
  if [ -z "$dm" ] || [ "$dm" = "$TMPDM" ]; then
    error "$name resolved to the recovery ramdisk; refusing to write"
  fi

  wt="$mp/.joan_write_test"
  if echo joan > "$wt" 2>/dev/null; then
    got=$(cat "$wt" 2>/dev/null)
    rm -f "$wt"
    [ "$got" = "joan" ] || error "$name failed write readback"
  else
    # Distinguish the two, because they need different answers and
    # guessing sent me chasing verity when /odm was simply full.
    free=$(df -k "$mp" 2>/dev/null | tail -1 | awk "{print \$4}")
    if mount | grep " $mp " | grep -q "[(,]ro[,)]"; then
      error "$name is mounted read-only; cannot install"
    else
      error "$name is writable but the write failed (${free:-?} KB free); cannot install"
    fi
  fi
}

ui_print "Mounting system"
mount_part system "$SYSMNT"
ui_print "Mounting product"
mount_part product "$PRODMNT"

# system-as-root: the partition root is /, and the /system tree sits in
# a system/ subdirectory of it.
SYS="$SYSMNT/system"
[ -d "$SYS/priv-app" ] || error "$SYS/priv-app missing; unexpected system layout"

mkdir -p "$SYS/priv-app/JoanIms"
chmod 755 "$SYS/priv-app/JoanIms" 2>/dev/null || true

ui_print "Removing joan-ims loopback listener"
rm -f "$SYS/bin/joan-ims" "$SYS/bin/joan-ims-ua" \
      "$SYS/etc/init/joan-ims.rc" "$SYS/etc/init/joan-imsd.rc"
rm -f "$SYSMNT/system_ext/bin/joan-ims-ua" \
      "$SYSMNT/system_ext/etc/init/joan-ims.rc"

ui_print "Installing ImsService priv-app"
copy_file "$TMP/app/joan-ims.apk" "$SYS/priv-app/JoanIms/JoanIms.apk" 644 u:object_r:system_file:s0
if [ -f "$TMP/etc/permissions/org.joan.ims.xml" ]; then
  copy_file "$TMP/etc/permissions/org.joan.ims.xml" \
    "$SYS/etc/permissions/org.joan.ims.xml" 644 u:object_r:system_file:s0
fi
if [ -f "$TMP/etc/permissions/android.hardware.telephony.ims.xml" ]; then
  copy_file "$TMP/etc/permissions/android.hardware.telephony.ims.xml" \
    "$SYS/etc/permissions/android.hardware.telephony.ims.xml" 644 u:object_r:system_file:s0
fi

# --- RRO: device-default ImsService in com.android.phone ----------------
# Without this ImsResolver classifies JoanIms as a carrier-style service
# with no features and never binds it.
if [ -f "$TMP/app/joan-ims-rro.apk" ]; then
  ui_print "Installing com.android.phone overlay (device-default IMS)"
  mkdir -p "$PRODMNT/overlay"
  copy_file "$TMP/app/joan-ims-rro.apk" \
    "$PRODMNT/overlay/JoanImsPhoneDefault.apk" 644 u:object_r:system_file:s0
fi

sync
umount "$PRODMNT" 2>/dev/null || true
umount "$SYSMNT" 2>/dev/null || true

sync
ui_print "Done. Reboot system."
exit 0
