From 5cf0ebf7a3322aa0b3448c917606e065ceae86c7 Mon Sep 17 00:00:00 2001
From: Fulgor Nymvale <fulgor@nym-skyforge>
Date: Sun, 27 Sep 2026 07:34:37 -0700
Subject: [PATCH] Survive denied emergency-call tracking on non-platform builds

Registering an OutgoingEmergencyCallListener is gated server-side on
READ_ACTIVE_EMERGENCY_SESSION (signature). A build signed with the
platform key holds it; a flashable zip's build does not, and the
SecurityException at startup and at every SIM state change crashed the
whole stack in a loop before ImsStack could register.

Catch the denial in registerForEmergencyCall and continue without
emergency-call tracking; platform-signed builds keep it in full.

Assisted-by: ZCode:GLM-5.3-Flash
Signed-off-by: Lance <Gero3977@gmail.com>
---
 .../enabler/aos/AosTelephonyCallbackTracker.java     | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/java/src/com/android/imsstack/enabler/aos/AosTelephonyCallbackTracker.java b/java/src/com/android/imsstack/enabler/aos/AosTelephonyCallbackTracker.java
index 5d8d46d..f139a20 100644
--- a/java/src/com/android/imsstack/enabler/aos/AosTelephonyCallbackTracker.java
+++ b/java/src/com/android/imsstack/enabler/aos/AosTelephonyCallbackTracker.java
@@ -235,7 +235,17 @@ public class AosTelephonyCallbackTracker {
     protected void registerForEmergencyCall() {
         if (mEmergencyCallListener == null) {
             mEmergencyCallListener = new EmergencyCallListener();
-            mEmergencyCallListener.register();
+            try {
+                mEmergencyCallListener.register();
+            } catch (RuntimeException e) {
+                // Registering an OutgoingEmergencyCallListener is gated on
+                // READ_ACTIVE_EMERGENCY_SESSION (signature). A build signed
+                // with the platform key holds it; a backport zip does not.
+                // Track no emergency call rather than crash the stack.
+                ImsLog.e(this, mSlotId, "registerForEmergencyCall: unavailable ("
+                        + e + "); emergency-call tracking disabled");
+                mEmergencyCallListener = null;
+            }
         }
     }
 
