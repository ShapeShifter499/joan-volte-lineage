From b275caba07bcf9c3ab9a31824567b28af4d940af Mon Sep 17 00:00:00 2001
From: Fulgor Nymvale <fulgor@nym-skyforge>
Date: Sun, 27 Sep 2026 12:41:45 -0700
Subject: [PATCH] ImsStack: log why an incoming-call notify fails before
 rejecting with 480

The framework side of notifyIncomingCall kept running after the future
had already completed on the bench, so the failure reason was invisible:
the stack answered 480 and the phone never rang. Log the exception (with
its stack trace) or the null result before deciding, through a logw
helper the class did not have yet.

Assisted-by: ZCode:GLM-5.3-Flash
Signed-off-by: Lance <Gero3977@gmail.com>
---
 .../imsservice/mmtel/ImsMmTelService.java        | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/java/src/com/android/imsstack/imsservice/mmtel/ImsMmTelService.java b/java/src/com/android/imsstack/imsservice/mmtel/ImsMmTelService.java
index a2137b8..2fdb815 100644
--- a/java/src/com/android/imsstack/imsservice/mmtel/ImsMmTelService.java
+++ b/java/src/com/android/imsstack/imsservice/mmtel/ImsMmTelService.java
@@ -433,6 +433,10 @@ public class ImsMmTelService extends MmTelFeature
         ImsLog.e("[ISIL] " + s);
     }
 
+    private static void logw(String s) {
+        ImsLog.w("[ISIL] " + s);
+    }
+
     private static void logi(String s) {
         ImsLog.i("[ISIL] " + s);
     }
@@ -499,6 +503,18 @@ public class ImsMmTelService extends MmTelFeature
                     () -> notifyIncomingCall(incomingSession, incomingSession.getCallId(), extras),
                     defaultExecutor)
                     .whenCompleteAsync((listener, exception) -> {
+                        if (exception != null) {
+                            // Bench 2026-09-27: the framework side of this notify
+                            // kept running (attachSession on the phone) after the
+                            // future had already completed - log exactly what threw
+                            // and with what, instead of failing silently.
+                            logw("notifyIncomingCall threw: " + exception);
+                            android.util.Log.w("ImsStackNotify", "notifyIncomingCall failed",
+                                    exception);
+                        } else if (listener == null) {
+                            logw("notifyIncomingCall: framework returned no listener"
+                                    + " (framework rejected the incoming call)");
+                        }
                         incomingSession.onIncomingcallNotified(
                                 exception == null && listener != null);
                     }, callExecutor);
-- 
