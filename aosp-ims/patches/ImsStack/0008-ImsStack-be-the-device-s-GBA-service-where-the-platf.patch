+package com.android.imsstack.gba;
+
+import android.net.ConnectivityManager;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.NetworkRequest;
+import android.net.TelephonyNetworkSpecifier;
+import android.net.Uri;
+import android.os.PersistableBundle;
+import android.telephony.CarrierConfigManager;
+import android.telephony.TelephonyManager;
+import android.telephony.gba.GbaService;
+import android.util.Base64;
+import android.util.Log;
+import android.util.SparseArray;
+
+import java.net.HttpURLConnection;
+import java.net.MalformedURLException;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * The device's GBA service (config_gba_package), for platforms that have
+ * none, such as LineageOS.
+ *
+ * ImsStack authenticates Ut/XCAP with GBA through
+ * TelephonyManager#bootstrapAuthenticationRequest, and Android's default
+ * GBA mode is GBA_ME for every carrier, so without a GbaService every XCAP
+ * server that asks for GBA refuses call forwarding, waiting and barring.
+ * This does GBA_ME (GbaBootstrap): bootstrapping with the carrier's BSF
+ * over HTTP digest AKA, the AKA on the USIM or ISIM, and Ks_NAF for each
+ * NAF. GBA_U is left to the UICC-less path: ImsStack falls back to GBA_ME
+ * when GBA_U fails for an unknown reason.
+ */
+public class ImsStackGbaService extends GbaService {
+    private static final String TAG = "ImsStackGba";
+    private static final String GBA_ME = "3GPP-bootstrapping";
+    private static final String GBA_U = "3GPP-bootstrapping-uicc";
+    /** Ks is not used this close to the end of its lifetime. */
+    private static final long EXPIRY_MARGIN_MS = 60_000;
+    private static final int XCAP_NETWORK_WAIT_MS = 5_000;
+
+    /** Ks by subscription, until its lifetime ends or the NAF refuses it. */
+    private final SparseArray<GbaBootstrap.Bootstrapped> mKeys = new SparseArray<>();
+
+    @Override
+    public void onAuthenticationRequest(int subId, int token, int appType, Uri nafUrl,
+            byte[] securityProtocol, boolean forceBootStrapping) {
+        String mode = nafUrl.getUserInfo();
+        String naf = nafUrl.getHost();
+        if (naf == null || naf.isEmpty()) {
+            reportAuthenticationFailure(token, TelephonyManager.GBA_FAILURE_REASON_INCORRECT_NAF_ID);
+            return;
+        }
+        if (GBA_U.equals(mode)) {
+            reportAuthenticationFailure(token, TelephonyManager.GBA_FAILURE_REASON_UNKNOWN);
+            return;
+        }
+        if (mode != null && !GBA_ME.equals(mode)) {
+            reportAuthenticationFailure(token,
+                    TelephonyManager.GBA_FAILURE_REASON_FEATURE_NOT_SUPPORTED);
+            return;
+        }
+        try {
+            GbaBootstrap.Bootstrapped ks = keys(subId, appType, forceBootStrapping);
+            reportKeysAvailable(token, ks.nafKey(naf, securityProtocol), ks.btid);
+            Log.i(TAG, "sub " + subId + ": key for " + naf);
+        } catch (GbaBootstrap.GbaException e) {
+            Log.w(TAG, "sub " + subId + ": " + e.getMessage());
+            reportAuthenticationFailure(token, e.reason);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "sub " + subId + ": " + e);
+            reportAuthenticationFailure(token, TelephonyManager.GBA_FAILURE_REASON_UNKNOWN);
+        }
+    }
+
+    private GbaBootstrap.Bootstrapped keys(int subId, int appType, boolean force)
+            throws GbaBootstrap.GbaException {
+        synchronized (mKeys) {
+            GbaBootstrap.Bootstrapped ks = mKeys.get(subId);
+            if (!force && ks != null
+                    && ks.expiresMillis - EXPIRY_MARGIN_MS > System.currentTimeMillis()) {
+                return ks;
+            }
+            mKeys.remove(subId);
+        }
+        TelephonyManager tm = getSystemService(TelephonyManager.class)
+                .createForSubscriptionId(subId);
+        String isimImpi = appType == TelephonyManager.APPTYPE_ISIM ? tm.getIsimImpi() : null;
+        boolean isim = isimImpi != null && !isimImpi.isEmpty();
+        String impi = isim ? isimImpi : impiFromImsi(tm);
+        int akaApp = isim ? TelephonyManager.APPTYPE_ISIM : TelephonyManager.APPTYPE_USIM;
+        URL bsf = bsfUrl(subId, tm);
+
+        ConnectivityManager cm = getSystemService(ConnectivityManager.class);
+        List<ConnectivityManager.NetworkCallback> requests = new ArrayList<>();
+        try {
+            // The network ImsStack sends XCAP over, if the carrier has one,
+            // else the default network.
+            List<Network> networks = new ArrayList<>();
+            Network xcap = xcapNetwork(cm, subId, requests);
+            if (xcap != null) {
+                networks.add(xcap);
+            }
+            networks.add(null);
+            GbaBootstrap.GbaException last = null;
+            for (Network n : networks) {
+                try {
+                    GbaBootstrap.Bootstrapped ks = GbaBootstrap.bootstrap(bsf, impi,
+                            (rand, autn) -> aka(tm, akaApp, rand, autn),
+                            url -> (HttpURLConnection) (n != null ? n.openConnection(url)
+                                    : url.openConnection()));
+                    synchronized (mKeys) {
+                        mKeys.put(subId, ks);
+                    }
+                    Log.i(TAG, "sub " + subId + ": bootstrapped with " + bsf.getHost()
+                            + (n != null ? " over XCAP" : ""));
+                    return ks;
+                } catch (GbaBootstrap.GbaException e) {
+                    last = e;
+                    if (e.reason != GbaBootstrap.GbaException.NETWORK) {
+                        break;
+                    }
+                }
+            }
+            throw last;
+        } finally {
+            for (ConnectivityManager.NetworkCallback cb : requests) {
+                try {
+                    cm.unregisterNetworkCallback(cb);
+                } catch (IllegalArgumentException ignored) {
+                    // Already released.
+                }
+            }
+        }
+    }
+
+    /** TS 23.003 13.3: the IMPI a UICC without an ISIM stands for. */
+    private static String impiFromImsi(TelephonyManager tm) throws GbaBootstrap.GbaException {
+        String imsi = tm.getSubscriberId();
+        String plmn = tm.getSimOperator();
+        if (imsi == null || plmn == null || plmn.length() < 5) {
+            throw new GbaBootstrap.GbaException(
+                    TelephonyManager.GBA_FAILURE_REASON_FEATURE_NOT_READY, "SIM not ready");
+        }
+        return imsi + "@ims" + homeDomain(plmn);
+    }
+
+    /** ".mnc<MNC>.mcc<MCC>.3gppnetwork.org", the MNC in three digits. */
+    private static String homeDomain(String plmn) {
+        String mnc = plmn.substring(3);
+        return ".mnc" + (mnc.length() == 2 ? "0" + mnc : mnc) + ".mcc" + plmn.substring(0, 3)
+                + ".3gppnetwork.org";
+    }
+
+    /** The carrier's BSF, or TS 23.003 16.2's default name for it. */
+    private URL bsfUrl(int subId, TelephonyManager tm) throws GbaBootstrap.GbaException {
+        CarrierConfigManager ccm = getSystemService(CarrierConfigManager.class);
+        PersistableBundle c = ccm == null ? null : ccm.getConfigForSubId(subId,
+                CarrierConfigManager.Bsf.KEY_BSF_SERVER_FQDN_STRING,
+                CarrierConfigManager.Bsf.KEY_BSF_SERVER_PORT_INT,
+                CarrierConfigManager.Bsf.KEY_BSF_TRANSPORT_TYPE_INT);
+        if (c == null) {
+            c = new PersistableBundle();
+        }
+        String host = c.getString(CarrierConfigManager.Bsf.KEY_BSF_SERVER_FQDN_STRING, "");
+        if (host.isEmpty()) {
+            String plmn = tm.getSimOperator();
+            if (plmn == null || plmn.length() < 5) {
+                throw new GbaBootstrap.GbaException(
+                        TelephonyManager.GBA_FAILURE_REASON_FEATURE_NOT_READY, "SIM not ready");
+            }
+            host = "bsf" + homeDomain(plmn).replace(".3gppnetwork.org", ".pub.3gppnetwork.org");
+        }
+        boolean tls = c.getInt(CarrierConfigManager.Bsf.KEY_BSF_TRANSPORT_TYPE_INT,
+                CarrierConfigManager.Ims.PREFERRED_TRANSPORT_TCP)
+                == CarrierConfigManager.Ims.PREFERRED_TRANSPORT_TLS;
+        int port = c.getInt(CarrierConfigManager.Bsf.KEY_BSF_SERVER_PORT_INT, tls ? 443 : 80);
+        try {
+            return new URL(tls ? "https" : "http", host, port, "/");
+        } catch (MalformedURLException e) {
+            throw new GbaBootstrap.GbaException(TelephonyManager.GBA_FAILURE_REASON_UNKNOWN,
+                    "BSF " + host + ": " + e.getMessage());
+        }
+    }
+
+    /** The subscription's XCAP network, if it comes up in a few seconds. */
+    private static Network xcapNetwork(ConnectivityManager cm, int subId,
+            List<ConnectivityManager.NetworkCallback> requests) {
+        if (cm == null) {
+            return null;
+        }
+        NetworkRequest req = new NetworkRequest.Builder()
+                .addTransportType(NetworkCapabilities.TRANSPORT_CELLULAR)
+                .addCapability(NetworkCapabilities.NET_CAPABILITY_XCAP)
+                .setNetworkSpecifier(new TelephonyNetworkSpecifier.Builder()
+                        .setSubscriptionId(subId).build())
+                .build();
+        CompletableFuture<Network> found = new CompletableFuture<>();
+        ConnectivityManager.NetworkCallback cb = new ConnectivityManager.NetworkCallback() {
+            @Override
+            public void onAvailable(Network network) {
+                found.complete(network);
+            }
+
+            @Override
+            public void onUnavailable() {
+                found.complete(null);
+            }
+        };
+        try {
+            cm.requestNetwork(req, cb, XCAP_NETWORK_WAIT_MS);
+            requests.add(cb);
+            return found.get(XCAP_NETWORK_WAIT_MS + 1000, TimeUnit.MILLISECONDS);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** AKA in 3G security context: L RAND L AUTN in, 'DB' or 'DC' out. */
+    private static GbaBootstrap.AkaResult aka(TelephonyManager tm, int app, byte[] rand,
+            byte[] autn) throws GbaBootstrap.GbaException {
+        byte[] data = new byte[2 + rand.length + autn.length];
+        data[0] = (byte) rand.length;
+        System.arraycopy(rand, 0, data, 1, rand.length);
+        data[1 + rand.length] = (byte) autn.length;
+        System.arraycopy(autn, 0, data, 2 + rand.length, autn.length);
+        String res = tm.getIccAuthentication(app, TelephonyManager.AUTHTYPE_EAP_AKA,
+                Base64.encodeToString(data, Base64.NO_WRAP));
+        if (res == null || res.isEmpty()) {
+            throw new GbaBootstrap.GbaException(TelephonyManager.GBA_FAILURE_REASON_UNKNOWN,
+                    "no AKA answer from the UICC");
+        }
+        return GbaBootstrap.AkaResult.parse(Base64.decode(res, Base64.DEFAULT));
+    }
+}
