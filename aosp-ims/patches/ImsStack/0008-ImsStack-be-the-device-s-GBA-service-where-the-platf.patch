+package com.android.imsstack.gba;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.fail;
+
+import androidx.test.filters.SmallTest;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+
+@SmallTest
+@RunWith(JUnit4.class)
+public class GbaBootstrapTest {
+    private static byte[] range(int from, int to) {
+        byte[] b = new byte[to - from];
+        for (int i = 0; i < b.length; i++) {
+            b[i] = (byte) (from + i);
+        }
+        return b;
+    }
+
+    @Test
+    public void testDigestResponse_rfc2617Example() {
+        assertEquals("6629fae49393a05397450978507c4ef1", GbaBootstrap.digestResponse("Mufasa",
+                "testrealm@host.com", "Circle Of Life".getBytes(StandardCharsets.UTF_8), "GET",
+                "/dir/index.html", "dcd98b7102dd2f0e8b11d0f600bfb0c093", "00000001", "0a4f113b",
+                "auth"));
+    }
+
+    @Test
+    public void testParseChallenge() throws Exception {
+        Map<String, String> ch = GbaBootstrap.parseChallenge("Digest realm=\"bsf.example.com\", "
+                + "nonce=\"a\\\"b\", qop=\"auth,auth-int\", algorithm=AKAv1-MD5");
+        assertEquals("bsf.example.com", ch.get("realm"));
+        assertEquals("a\"b", ch.get("nonce"));
+        assertEquals("auth,auth-int", ch.get("qop"));
+        assertEquals("AKAv1-MD5", ch.get("algorithm"));
+    }
+
+    @Test
+    public void testAkaResult_successAndSyncFailure() throws Exception {
+        byte[] db = {(byte) 0xdb, 2, 1, 2, 3, 10, 11, 12, 3, 20, 21, 22};
+        GbaBootstrap.AkaResult r = GbaBootstrap.AkaResult.parse(db);
+        assertArrayEquals(new byte[] {1, 2}, r.res);
+        assertArrayEquals(new byte[] {10, 11, 12}, r.ck);
+        assertArrayEquals(new byte[] {20, 21, 22}, r.ik);
+        assertNull(r.auts);
+        byte[] dc = {(byte) 0xdc, 2, 7, 8};
+        assertArrayEquals(new byte[] {7, 8}, GbaBootstrap.AkaResult.parse(dc).auts);
+        try {
+            GbaBootstrap.AkaResult.parse(new byte[] {(byte) 0x98, 0x62});
+            fail("an error status word is not an AKA answer");
+        } catch (GbaBootstrap.GbaException expected) {
+            assertEquals(GbaBootstrap.GbaException.UNKNOWN, expected.reason);
+        }
+    }
+
+    @Test
+    public void testNafKey_ts33220AnnexB() {
+        byte[] ks = range(0, 32);  // CK || IK
+        assertEquals("273152e7675c40055af1395a22e6a563cbe29075e3a3d3462c55660e4ec54094",
+                GbaBootstrap.hex(GbaBootstrap.nafKey(ks, range(32, 48),
+                        "001010123456789@ims.mnc001.mcc001.3gppnetwork.org",
+                        "xcap.ims.mnc001.mcc001.pub.3gppnetwork.org", new byte[] {1, 0, 0, 0, 2})));
+    }
+}
