+package com.android.imsstack.gba;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.time.OffsetDateTime;
+import java.util.Base64;
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * GBA_ME bootstrapping over the Ub interface (3GPP TS 24.109, TS 33.220):
+ * HTTP digest AKA with the BSF (RFC 3310, AKAv1-MD5), and the NAF key
+ * derivation. Plain Java, so the build checks it on the host against a
+ * BSF of its own.
+ */
+public final class GbaBootstrap {
+    /** The User-Agent product token TS 24.109 requires towards the BSF. */
+    public static final String USER_AGENT = "Android 3gpp-gba";
+    private static final int TIMEOUT_MS = 15000;
+    private static final String EMPTY_BODY_MD5 = hex(md5(new byte[0]));
+
+    private GbaBootstrap() {}
+
+    /** Why bootstrapping failed, as TelephonyManager.GBA_FAILURE_REASON_*. */
+    public static final class GbaException extends Exception {
+        public static final int UNKNOWN = 0;
+        public static final int NETWORK = 3;
+        public final int reason;
+
+        public GbaException(int reason, String message) {
+            super(message);
+            this.reason = reason;
+        }
+    }
+
+    /** The UICC's answer to an AKA challenge: RES, CK and IK, or AUTS. */
+    public static final class AkaResult {
+        public final byte[] res;
+        public final byte[] ck;
+        public final byte[] ik;
+        public final byte[] auts;
+
+        private AkaResult(byte[] res, byte[] ck, byte[] ik, byte[] auts) {
+            this.res = res;
+            this.ck = ck;
+            this.ik = ik;
+            this.auts = auts;
+        }
+
+        public static AkaResult success(byte[] res, byte[] ck, byte[] ik) {
+            return new AkaResult(res, ck, ik, null);
+        }
+
+        public static AkaResult syncFailure(byte[] auts) {
+            return new AkaResult(null, null, null, auts);
+        }
+
+        /**
+         * The AUTHENTICATE response in 3G security context (TS 31.102
+         * 7.1.2.1) as TelephonyManager#getIccAuthentication returns it:
+         * 'DB' L RES L CK L IK [L Kc], or 'DC' L AUTS.
+         */
+        public static AkaResult parse(byte[] r) throws GbaException {
+            try {
+                int i = 1;
+                if ((r[0] & 0xff) == 0xdc) {
+                    return syncFailure(slice(r, i + 1, r[i] & 0xff));
+                }
+                if ((r[0] & 0xff) != 0xdb) {
+                    throw new GbaException(GbaException.UNKNOWN, "AKA rejected by the UICC");
+                }
+                byte[] res = slice(r, i + 1, r[i] & 0xff);
+                i += 1 + res.length;
+                byte[] ck = slice(r, i + 1, r[i] & 0xff);
+                i += 1 + ck.length;
+                byte[] ik = slice(r, i + 1, r[i] & 0xff);
+                return success(res, ck, ik);
+            } catch (ArrayIndexOutOfBoundsException | NegativeArraySizeException e) {
+                throw new GbaException(GbaException.UNKNOWN, "malformed AKA response");
+            }
+        }
+
+        private static byte[] slice(byte[] b, int from, int len) {
+            if (from + len > b.length) {
+                throw new ArrayIndexOutOfBoundsException(from + len);
+            }
+            byte[] out = new byte[len];
+            System.arraycopy(b, from, out, 0, len);
+            return out;
+        }
+    }
+
+    /** Runs AKA on the USIM or ISIM. */
+    public interface Aka {
+        AkaResult authenticate(byte[] rand, byte[] autn) throws GbaException;
+    }
+
+    /** Opens connections, on the network the caller chose. */
+    public interface Opener {
+        HttpURLConnection open(URL url) throws IOException;
+    }
+
+    /** The outcome of bootstrapping: Ks with what identifies it. */
+    public static final class Bootstrapped {
+        public final String impi;
+        public final byte[] ks;
+        public final byte[] rand;
+        public final String btid;
+        public final long expiresMillis;
+
+        Bootstrapped(String impi, byte[] ks, byte[] rand, String btid, long expiresMillis) {
+            this.impi = impi;
+            this.ks = ks;
+            this.rand = rand;
+            this.btid = btid;
+            this.expiresMillis = expiresMillis;
+        }
+
+        /** Ks_NAF for a NAF (TS 33.220 4.5.2), with its Ua security protocol id. */
+        public byte[] nafKey(String nafFqdn, byte[] uaProtocolId) {
+            return GbaBootstrap.nafKey(ks, rand, impi, nafFqdn, uaProtocolId);
+        }
+    }
+
+    /**
+     * Bootstraps with the BSF: an empty digest first, then the answer to its
+     * AKA challenge, resynchronising once if the UICC asks for it.
+     */
+    public static Bootstrapped bootstrap(URL bsf, String impi, Aka aka, Opener opener)
+            throws GbaException {
+        try {
+            return run(bsf, impi, aka, opener);
+        } catch (IllegalArgumentException e) {
+            throw new GbaException(GbaException.UNKNOWN, "BSF: " + e.getMessage());
+        }
+    }
+
+    private static Bootstrapped run(URL bsf, String impi, Aka aka, Opener opener)
+            throws GbaException {
+        String realm = bsf.getHost();
+        Map<String, String> challenge = challenge(open(opener, bsf,
+                "Digest username=" + quote(impi) + ", realm=" + quote(realm)
+                        + ", nonce=\"\", uri=\"/\", response=\"\""));
+        for (int attempt = 0; attempt < 2; attempt++) {
+            byte[] nonce = Base64.getDecoder().decode(require(challenge, "nonce"));
+            if (nonce.length < 32) {
+                throw new GbaException(GbaException.UNKNOWN, "nonce too short for RAND and AUTN");
+            }
+            byte[] rand = new byte[16];
+            byte[] autn = new byte[16];
+            System.arraycopy(nonce, 0, rand, 0, 16);
+            System.arraycopy(nonce, 16, autn, 0, 16);
+            AkaResult aka1 = aka.authenticate(rand, autn);
+            if (aka1.auts != null) {
+                // RFC 3310 3.4: AUTS with a response over an empty password;
+                // the BSF answers with a fresh challenge.
+                challenge = challenge(open(opener, bsf,
+                        authorization(impi, challenge, new byte[0], aka1.auts)));
+                continue;
+            }
+            HttpURLConnection c = open(opener, bsf, authorization(impi, challenge, aka1.res, null));
+            try {
+                int code = c.getResponseCode();
+                if (code != HttpURLConnection.HTTP_OK) {
+                    throw new GbaException(GbaException.UNKNOWN, "BSF answered " + code);
+                }
+                String body = new String(readAll(c.getInputStream()), StandardCharsets.UTF_8);
+                String btid = element(body, "btid");
+                long expires = OffsetDateTime.parse(element(body, "lifetime"))
+                        .toInstant().toEpochMilli();
+                byte[] ks = new byte[aka1.ck.length + aka1.ik.length];
+                System.arraycopy(aka1.ck, 0, ks, 0, aka1.ck.length);
+                System.arraycopy(aka1.ik, 0, ks, aka1.ck.length, aka1.ik.length);
+                return new Bootstrapped(impi, ks, rand, btid, expires);
+            } catch (IOException | RuntimeException e) {
+                throw new GbaException(GbaException.NETWORK, "BSF: " + e);
+            } finally {
+                c.disconnect();
+            }
+        }
+        throw new GbaException(GbaException.UNKNOWN, "no usable challenge after resync");
+    }
+
+    /**
+     * KDF of TS 33.220 Annex B: HMAC-SHA-256(Ks, S), S = 0x01 || "gba-me" ||
+     * L0 || RAND || L1 || IMPI || L2 || NAF_Id || L3, with each L the 2-byte
+     * length of what precedes it and NAF_Id the NAF's FQDN followed by the Ua
+     * security protocol identifier.
+     */
+    public static byte[] nafKey(byte[] ks, byte[] rand, String impi, String nafFqdn,
+            byte[] uaProtocolId) {
+        ByteArrayOutputStream s = new ByteArrayOutputStream();
+        s.write(0x01);
+        param(s, "gba-me".getBytes(StandardCharsets.UTF_8));
+        param(s, rand);
+        param(s, impi.getBytes(StandardCharsets.UTF_8));
+        byte[] fqdn = nafFqdn.getBytes(StandardCharsets.UTF_8);
+        byte[] nafId = new byte[fqdn.length + uaProtocolId.length];
+        System.arraycopy(fqdn, 0, nafId, 0, fqdn.length);
+        System.arraycopy(uaProtocolId, 0, nafId, fqdn.length, uaProtocolId.length);
+        param(s, nafId);
+        try {
+            Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(new SecretKeySpec(ks, "HmacSHA256"));
+            return mac.doFinal(s.toByteArray());
+        } catch (GeneralSecurityException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static void param(ByteArrayOutputStream s, byte[] p) {
+        s.write(p, 0, p.length);
+        s.write((p.length >> 8) & 0xff);
+        s.write(p.length & 0xff);
+    }
+
+    /**
+     * The Authorization header answering a challenge: RFC 2617 digest, the
+     * password being RES (RFC 3310), qop auth-int over the empty body where
+     * the BSF offers it.
+     */
+    static String authorization(String impi, Map<String, String> ch, byte[] password,
+            byte[] auts) {
+        String realm = require(ch, "realm");
+        String nonce = require(ch, "nonce");
+        String qops = ch.getOrDefault("qop", "");
+        String qop = qops.contains("auth-int") ? "auth-int" : qops.contains("auth") ? "auth" : null;
+        String cnonce = hex(randomBytes(16));
+        String nc = "00000001";
+        String response = digestResponse(impi, realm, password, "GET", "/", nonce, nc, cnonce, qop);
+        StringBuilder h = new StringBuilder("Digest username=").append(quote(impi))
+                .append(", realm=").append(quote(realm))
+                .append(", nonce=").append(quote(nonce))
+                .append(", uri=\"/\"");
+        if (qop != null) {
+            h.append(", qop=").append(qop).append(", nc=").append(nc)
+                    .append(", cnonce=").append(quote(cnonce));
+        }
+        h.append(", response=").append(quote(response));
+        if (ch.containsKey("opaque")) {
+            h.append(", opaque=").append(quote(ch.get("opaque")));
+        }
+        h.append(", algorithm=").append(ch.getOrDefault("algorithm", "AKAv1-MD5"));
+        if (auts != null) {
+            h.append(", auts=").append(quote(Base64.getEncoder().encodeToString(auts)));
+        }
+        return h.toString();
+    }
+
+    /** RFC 2617 3.2.2.1: the request-digest, with a binary password. */
+    static String digestResponse(String user, String realm, byte[] password, String method,
+            String uri, String nonce, String nc, String cnonce, String qop) {
+        byte[] a1Prefix = (user + ":" + realm + ":").getBytes(StandardCharsets.UTF_8);
+        byte[] a1 = new byte[a1Prefix.length + password.length];
+        System.arraycopy(a1Prefix, 0, a1, 0, a1Prefix.length);
+        System.arraycopy(password, 0, a1, a1Prefix.length, password.length);
+        String ha1 = hex(md5(a1));
+        String a2 = method + ":" + uri + ("auth-int".equals(qop) ? ":" + EMPTY_BODY_MD5 : "");
+        String ha2 = hex(md5(a2.getBytes(StandardCharsets.UTF_8)));
+        String kd = qop == null ? ha1 + ":" + nonce + ":" + ha2
+                : ha1 + ":" + nonce + ":" + nc + ":" + cnonce + ":" + qop + ":" + ha2;
+        return hex(md5(kd.getBytes(StandardCharsets.UTF_8)));
+    }
+
+    /** The parameters of a WWW-Authenticate: Digest challenge. */
+    static Map<String, String> parseChallenge(String header) throws GbaException {
+        if (header == null || !header.trim().regionMatches(true, 0, "Digest", 0, 6)) {
+            throw new GbaException(GbaException.UNKNOWN, "no digest challenge: " + header);
+        }
+        Map<String, String> out = new LinkedHashMap<>();
+        Matcher m = Pattern.compile("([A-Za-z-]+)\\s*=\\s*(\"((?:[^\"\\\\]|\\\\.)*)\"|[^,\\s]+)")
+                .matcher(header.trim().substring(6));
+        while (m.find()) {
+            String v = m.group(3) != null ? m.group(3).replaceAll("\\\\(.)", "$1") : m.group(2);
+            out.put(m.group(1).toLowerCase(Locale.ROOT), v);
+        }
+        return out;
+    }
+
+    private static Map<String, String> challenge(HttpURLConnection c) throws GbaException {
+        try {
+            int code = c.getResponseCode();
+            if (code != HttpURLConnection.HTTP_UNAUTHORIZED) {
+                throw new GbaException(GbaException.UNKNOWN, "BSF answered " + code
+                        + " where a challenge was expected");
+            }
+            return parseChallenge(c.getHeaderField("WWW-Authenticate"));
+        } catch (IOException e) {
+            throw new GbaException(GbaException.NETWORK, "BSF: " + e);
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    private static HttpURLConnection open(Opener opener, URL bsf, String authorization)
+            throws GbaException {
+        try {
+            HttpURLConnection c = opener.open(bsf);
+            c.setConnectTimeout(TIMEOUT_MS);
+            c.setReadTimeout(TIMEOUT_MS);
+            c.setInstanceFollowRedirects(false);
+            c.setUseCaches(false);
+            c.setRequestMethod("GET");
+            c.setRequestProperty("User-Agent", USER_AGENT);
+            c.setRequestProperty("Authorization", authorization);
+            return c;
+        } catch (IOException e) {
+            throw new GbaException(GbaException.NETWORK, "BSF: " + e);
+        }
+    }
+
+    private static String element(String xml, String name) throws GbaException {
+        Matcher m = Pattern.compile("<(?:\\w+:)?" + name + ">\\s*([^<]*?)\\s*</(?:\\w+:)?"
+                + name + ">").matcher(xml);
+        if (!m.find()) {
+            throw new GbaException(GbaException.UNKNOWN, "no <" + name + "> from the BSF");
+        }
+        return m.group(1);
+    }
+
+    private static String require(Map<String, String> ch, String key) {
+        String v = ch.get(key);
+        if (v == null) {
+            throw new IllegalArgumentException("challenge without " + key);
+        }
+        return v;
+    }
+
+    private static String quote(String s) {
+        return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
+    }
+
+    private static byte[] readAll(InputStream in) throws IOException {
+        try (InputStream i = in) {
+            return i.readAllBytes();
+        }
+    }
+
+    private static byte[] randomBytes(int n) {
+        byte[] b = new byte[n];
+        new SecureRandom().nextBytes(b);
+        return b;
+    }
+
+    static byte[] md5(byte[] b) {
+        try {
+            return MessageDigest.getInstance("MD5").digest(b);
+        } catch (GeneralSecurityException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    static String hex(byte[] b) {
+        StringBuilder sb = new StringBuilder(b.length * 2);
+        for (byte x : b) {
+            sb.append(String.format(Locale.ROOT, "%02x", x & 0xff));
+        }
+        return sb.toString();
+    }
+}
