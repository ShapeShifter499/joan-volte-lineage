From 66306acad2b3cbbf1d07aa3c19ae3b187a93667e Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Tue, 13 Oct 2026 04:54:19 -0700
Subject: [PATCH] ImsStack: build against Android 15 telephony APIs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Keep krazey’s pre-Android-17 emergency monitor adapter and shim only the three Android 17 APIs that Android 15 still lacks: requestUiccIari, EXTRA_SETUP_EVENT_LIST, and BarringInfo.getCellIdentity.

Assisted-by: Hermes-Agent:stepfun/step-5-preview:free
Signed-off-by: Lance <Gero3977@gmail.com>
---
 java/Android.bp                               | 36 +++++++++++++------
 .../base/TelephonyManagerProxyImpl.java       | 27 +++-----------
 .../imsstack/core/StkSetupEventReceiver.java  |  7 +++-
 .../imsstack/core/agents/ImsRadioAgent.java   | 20 ++++++++++-
 tests/java/Android.bp                         |  9 +----
 5 files changed, 55 insertions(+), 44 deletions(-)

diff --git a/java/Android.bp b/java/Android.bp
index a1da3c7..59901c0 100644
--- a/java/Android.bp
+++ b/java/Android.bp
@@ -34,7 +34,18 @@ filegroup {
     ],
 }
 
-android_library {
+// Android 15 Soong cannot use select() on Java srcs. Keep the upstream
+// configuration variable, but expose it through the legacy Soong-config
+// module mechanism understood by LineageOS 22.2.
+soong_config_module_type {
+    name: "imsstack_compat_android_library",
+    module_type: "android_library",
+    config_namespace: "imsstack_namespace",
+    bool_variables: ["use_android16_telephony_compat"],
+    properties: ["srcs"],
+}
+
+imsstack_compat_android_library {
     name: "imsstack",
     platform_apis: true,
     manifest: "AndroidManifest-lib.xml",
@@ -44,16 +55,19 @@ android_library {
     resource_dirs: [
         "res",
     ],
-    srcs: [
-        ":imsstack-java-common-srcs",
-    ] + select(soong_config_variable("imsstack_namespace", "use_android16_telephony_compat"), {
-        true: [
-            "src/com/android/imsstack/core/agents/DomainSelectionEmergencyModeMonitorCompat.java",
-        ],
-        default: [
-            "src/com/android/imsstack/core/agents/DomainSelectionEmergencyModeMonitor.java",
-        ],
-    }),
+    srcs: [":imsstack-java-common-srcs"],
+    soong_config_variables: {
+        use_android16_telephony_compat: {
+            srcs: [
+                "src/com/android/imsstack/core/agents/DomainSelectionEmergencyModeMonitorCompat.java",
+            ],
+            conditions_default: {
+                srcs: [
+                    "src/com/android/imsstack/core/agents/DomainSelectionEmergencyModeMonitor.java",
+                ],
+            },
+        },
+    },
     aidl: {
         include_dirs: [
             "frameworks/native/aidl/gui",
diff --git a/java/src/com/android/imsstack/base/TelephonyManagerProxyImpl.java b/java/src/com/android/imsstack/base/TelephonyManagerProxyImpl.java
index a319c3e..7194b2a 100644
--- a/java/src/com/android/imsstack/base/TelephonyManagerProxyImpl.java
+++ b/java/src/com/android/imsstack/base/TelephonyManagerProxyImpl.java
@@ -274,29 +274,10 @@ public class TelephonyManagerProxyImpl implements TelephonyManagerProxy {
 
     @Override
     public Set<String> requestUiccIari() {
-        TelephonyManager tm = getTelephonyManager();
-        if (tm == null) {
-            return Collections.emptySet();
-        }
-        CompletableFuture<Set<String>> future = new CompletableFuture<>();
-        OutcomeReceiver<Set<String>, Exception> callback = new OutcomeReceiver<>() {
-            @Override
-            public void onResult(Set<String> iariSet) {
-                future.complete(iariSet);
-            }
-            @Override
-            public void onError(@NonNull Exception ex) {
-                future.complete(Collections.emptySet());
-            }
-        };
-
-        tm.requestUiccIari(ExecutorHolder.sExecutor, callback);
-
-        try {
-            return future.get(1, TimeUnit.SECONDS);
-        } catch (Exception e) {
-            return Collections.emptySet();
-        }
+        // Android 15 backport: TelephonyManager#requestUiccIari arrived in Android 17, and
+        // Android 15 has no other route to the ISIM's IARI list (used by RCS only). Report
+        // none, which is what a failed request returns.
+        return Collections.emptySet();
     }
 
     @Override
diff --git a/java/src/com/android/imsstack/core/StkSetupEventReceiver.java b/java/src/com/android/imsstack/core/StkSetupEventReceiver.java
index e4f8fe3..c19ed62 100644
--- a/java/src/com/android/imsstack/core/StkSetupEventReceiver.java
+++ b/java/src/com/android/imsstack/core/StkSetupEventReceiver.java
@@ -30,6 +30,11 @@ import com.android.imsstack.util.ImsLog;
  * Receives and processes stk setup event list intent.
  */
 public class StkSetupEventReceiver extends BroadcastReceiver {
+    // Android 15 backport: TelephonyManager#EXTRA_SETUP_EVENT_LIST arrived in Android 17,
+    // the release that starts sending ACTION_STK_SETUP_EVENT_LIST.
+    private static final String EXTRA_SETUP_EVENT_LIST =
+            "android.telephony.extra.SETUP_EVENT_LIST";
+
     @Override
     public void onReceive(Context context, Intent intent) {
         ImsLog.d("onReceive: " + intent);
@@ -41,7 +46,7 @@ public class StkSetupEventReceiver extends BroadcastReceiver {
 
         UsatInterface usat = (sim != null) ? sim.getUsatInterface() : null;
         if (usat != null) {
-            int[] setupEventList = intent.getIntArrayExtra(TelephonyManager.EXTRA_SETUP_EVENT_LIST);
+            int[] setupEventList = intent.getIntArrayExtra(EXTRA_SETUP_EVENT_LIST);
             if (setupEventList != null) {
                 usat.updateSetupEventList(setupEventList);
             }
diff --git a/java/src/com/android/imsstack/core/agents/ImsRadioAgent.java b/java/src/com/android/imsstack/core/agents/ImsRadioAgent.java
index bec9142..c43fe4e 100644
--- a/java/src/com/android/imsstack/core/agents/ImsRadioAgent.java
+++ b/java/src/com/android/imsstack/core/agents/ImsRadioAgent.java
@@ -19,6 +19,7 @@ import android.annotation.NonNull;
 import android.content.Context;
 import android.os.Handler;
 import android.os.Looper;
+import android.os.Parcel;
 import android.telephony.AccessNetworkConstants;
 import android.telephony.BarringInfo;
 import android.telephony.BarringInfo.BarringServiceInfo;
@@ -383,9 +384,26 @@ public class ImsRadioAgent implements ImsRadioInterface {
         return id;
     }
 
+    /**
+     * Android 15 backport: BarringInfo#getCellIdentity arrived in Android 17. BarringInfo
+     * parcels its CellIdentity first, so read it back from there.
+     */
+    private static CellIdentity getBarringCellIdentity(BarringInfo barringInfo) {
+        Parcel p = Parcel.obtain();
+        try {
+            barringInfo.writeToParcel(p, 0);
+            p.setDataPosition(0);
+            return p.readParcelable(CellIdentity.class.getClassLoader(), CellIdentity.class);
+        } catch (RuntimeException e) {
+            return null;
+        } finally {
+            p.recycle();
+        }
+    }
+
     @VisibleForTesting
     protected void handleBarringInfo(BarringInfo barringInfo) {
-        CellIdentity ci = barringInfo.getCellIdentity();
+        CellIdentity ci = getBarringCellIdentity(barringInfo);
         if (ci instanceof CellIdentityNr) {
             ImsLog.i(this, mSlotId, "handleBarringInfo: Ignoring, cellType=NR");
             return;
diff --git a/tests/java/Android.bp b/tests/java/Android.bp
index 3359841..2b6e455 100644
--- a/tests/java/Android.bp
+++ b/tests/java/Android.bp
@@ -35,14 +35,7 @@ android_test {
     defaults: [
         "imsstack_mockito_target_extended_defaults",
     ],
-    srcs: [
-        ":imsstack-java-test-common-srcs",
-    ] + select(soong_config_variable("imsstack_namespace", "use_android16_telephony_compat"), {
-        true: [],
-        default: [
-            "src/com/android/imsstack/core/agents/EmergencyStateAgentTest.java",
-        ],
-    }),
+    srcs: [":imsstack-java-test-common-srcs"],
     libs: [
         "android.test.base.stubs.system",
         "android.test.mock.stubs.system",
