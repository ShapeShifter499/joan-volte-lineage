From c875526cfd95bbd93edfb005728c9b19285d5c12 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Mon, 28 Sep 2026 12:26:31 -0700
Subject: [PATCH] ImsStack: report IWLAN only while the IMS APN runs over WLAN

0011 reports the WLAN-transport PS registration's access network
(IWLAN) whenever that registration is in service. IWLAN reports it in
service as soon as Wi-Fi is up, also while the IMS APN stays on LTE:
Wi-Fi calling switched off, or no ePDG tunnel yet. The native engine
then labelled its LTE registration IWLAN and every attempt failed about
1.2 s later with REG_RESP_NETWORK_TIMEOUT, every ~6 s (bench, T-Mobile,
2026-09-28: 44 in a row); dials fell back to CS, which this modem
refuses, and after Wi-Fi calling was switched off the stack sat
unregistered until the IMS PDN was rebuilt.

Take the WLAN registration only when the IMS APN itself is connected
with the WLAN IP-CAN category, the signal Apn already derives from the
data connection's network type and hands the native side.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5-5
---
 .../imsstack/core/agents/dcm/DcUtils.java       | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/java/src/com/android/imsstack/core/agents/dcm/DcUtils.java b/java/src/com/android/imsstack/core/agents/dcm/DcUtils.java
index 72a326e..231c9df 100644
--- a/java/src/com/android/imsstack/core/agents/dcm/DcUtils.java
+++ b/java/src/com/android/imsstack/core/agents/dcm/DcUtils.java
@@ -34,6 +34,9 @@ import com.android.imsstack.base.AppContext;
 import com.android.imsstack.base.ImsPrivateProperties;
 import com.android.imsstack.base.MSimUtils;
 import com.android.imsstack.base.TelephonyManagerProxy;
+import com.android.imsstack.core.agents.dcmif.EApnType;
+import com.android.imsstack.core.agents.dcmif.IApn;
+import com.android.imsstack.core.agents.dcmif.IDcApn;
 import com.android.imsstack.core.agents.dcmif.IDcUtils;
 import com.android.imsstack.util.ImsLog;
 import com.android.imsstack.util.Log;
@@ -108,7 +111,11 @@ public class DcUtils implements IDcUtils {
         // unregistered, and every dial fell back to CS. When the
         // WLAN-transport PS registration is in service (IWLAN), that is
         // the network the registration actually runs over: report it.
-        if (ss != null) {
+        // But only while the IMS APN itself is on WLAN: the WLAN
+        // registration is in service whenever Wi-Fi is up, also when the
+        // IMS APN stays on LTE (Wi-Fi calling off, or no tunnel), and a
+        // registration labelled IWLAN there fails at once.
+        if (ss != null && isImsOnWlan()) {
             NetworkRegistrationInfo wlanNri = ss.getNetworkRegistrationInfo(
                     NetworkRegistrationInfo.DOMAIN_PS,
                     AccessNetworkConstants.TRANSPORT_TYPE_WLAN);
@@ -214,6 +221,14 @@ public class DcUtils implements IDcUtils {
     }
 
     @VisibleForTesting
+    /** Whether the IMS APN is connected over the WLAN transport (an ePDG tunnel). */
+    private boolean isImsOnWlan() {
+        IDcApn dcApn = DcFactory.getDcAgent(IDcApn.class, mSlotId);
+        int ims = EApnType.IMS.getType();
+        return dcApn != null && dcApn.isConnected(ims)
+                && dcApn.getIpcanCategory(ims) == IApn.IPCAN_CATEGORY_WLAN;
+    }
+
     protected String[] getAccessNetworkInfoFromCache(int networkType) {
         ImsLog.d(mSlotId, "ANI: from cache");
         List<String> ani = mRecentAccessNetworkInfos.get(networkType);
-- 
