+    /**
+     * Queue an operation while a deferred native open is pending, or drop it
+     * after close/failure. Returning true means the caller must not dereference
+     * mLocalSession now.
+     */
+    private boolean deferLocalOperation(String name, Runnable operation) {
+        if (mDeferredOpenState == DeferredOpenState.WAITING_FOR_CONFIG
+                || mDeferredOpenState == DeferredOpenState.OPENING) {
+            Log.i(TAG, name + " before native open: queued");
+            mDeferredCalls.add(operation);
+            return true;
+        }
+        if (mDeferredOpenState == DeferredOpenState.CLOSING || mLocalSession == null) {
+            Log.w(TAG, name + " with no native session: dropped");
+            return true;
+        }
+        return false;
+    }
+
+    private void handleDeferredOpenSuccess(Object session) {
+        if (!(session instanceof AudioLocalSession)) {
+            handleDeferredOpenFailure(ImsMediaSession.RESULT_INVALID_PARAM);
+            return;
+        }
+
+        mLocalSession = (AudioLocalSession) session;
+        AudioConfig config = mDeferredModifyConfig;
+        ArrayList<Runnable> deferredCalls = new ArrayList<>(mDeferredCalls);
+        clearDeferredOpen();
+
+        // openSessionSuccess was already delivered when the Java session was
+        // created. The native open completes the first modify, not a second
+        // open, so report exactly one modify response.
+        if (config != null) {
+            handleModifySessionResponse(config, ImsMediaSession.RESULT_SUCCESS);
+        }
+        for (Runnable operation : deferredCalls) {
+            operation.run();
+        }
+    }
+
+    private void handleDeferredOpenFailure(int error) {
+        AudioConfig config = mDeferredModifyConfig;
+        clearDeferredOpen();
+        if (config != null) {
+            handleModifySessionResponse(config, error);
+        }
+    }
+
+    private void clearDeferredOpen() {
+        mDeferredOpenState = DeferredOpenState.NONE;
+        mDeferredOpenParams = null;
+        mDeferredModifyConfig = null;
+        mDeferredCalls.clear();
+    }
