-        } else {
+        } else if (mDeferredOpenState == DeferredOpenState.WAITING_FOR_CONFIG) {
+            // No native session was created, so there will be no native close
+            // event. Complete the close locally.
+            clearDeferredOpen();
+            handleSessionClosed();
+        } else if (mDeferredOpenState == DeferredOpenState.OPENING) {
+            // The native open request is already in flight. Queue close behind
+            // it, fail the pending modify exactly once, and ignore its later
+            // open-success callback.
+            AudioConfig config = mDeferredModifyConfig;
+            mDeferredModifyConfig = null;
+            mDeferredCalls.clear();
+            mDeferredOpenState = DeferredOpenState.CLOSING;
