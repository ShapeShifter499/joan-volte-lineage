From 7c67cb0f17558baecdfcb6cbe46fc83f309eac2e Mon Sep 17 00:00:00 2001
From: Fulgor Nymvale <fulgor@nym-skyforge>
Date: Mon, 28 Sep 2026 04:11:35 -0700
Subject: [PATCH] Instrument the socket monitor and receive path

Downlink RTP reaches the kernel socket (Recv-Q grows to 127KB in the ss
snapshots) while the decoder counts zero: the shared select loop holds
registered sockets yet never drains them. Log the registered fd list
when it changes, the select result, and recv attempts/results so the
next call shows where the chain breaks.

Assisted-by: ZCode:GLM-5.3-Flash
Signed-off-by: Lance <Gero3977@gmail.com>
---
 .../libimsmedia/core/utils/ImsMediaSocket.cpp | 20 ++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/service/src/com/android/telephony/imsmedia/lib/libimsmedia/core/utils/ImsMediaSocket.cpp b/service/src/com/android/telephony/imsmedia/lib/libimsmedia/core/utils/ImsMediaSocket.cpp
index 1a7d73c..29b935e 100644
--- a/service/src/com/android/telephony/imsmedia/lib/libimsmedia/core/utils/ImsMediaSocket.cpp
+++ b/service/src/com/android/telephony/imsmedia/lib/libimsmedia/core/utils/ImsMediaSocket.cpp
@@ -302,6 +302,14 @@ int32_t ImsMediaSocket::ReceiveFrom(uint8_t* pData, uint32_t nBufferSize)
     sockaddr_storage ss;
     pstSockAddr = reinterpret_cast<sockaddr*>(&ss);
     len = recvfrom(mSocketFd, pData, nBufferSize, 0, pstSockAddr, &nSockAddrLen);
+    {
+        static int nRecvLogCounter = 0;
+        if (++nRecvLogCounter % 50 == 0)
+        {
+            IMLOGI3("[ReceiveFrom] fd[%d], len[%d], recvCount[%d]", mSocketFd, len,
+                    nRecvLogCounter);
+        }
+    }
 
     if (len > 0)
     {
@@ -493,6 +501,7 @@ uint32_t ImsMediaSocket::SetSocketFD(void* pReadFds, void* pWriteFds, void* pExc
     FD_ZERO(reinterpret_cast<fd_set*>(pExceptFds));
     IMLOGD_PACKET0(IM_PACKET_LOG_SOCKET, "[SetSocketFD]");
 
+    std::string fds;
     for (auto& i : slistRxSocket)
     {
         int32_t socketFD = i->GetSocketFd();
@@ -502,8 +511,11 @@ uint32_t ImsMediaSocket::SetSocketFD(void* pReadFds, void* pWriteFds, void* pExc
         {
             nMaxSD = socketFD;
         }
+
+        fds += std::to_string(socketFD) + " ";
     }
 
+    IMLOGI2("[SetSocketFD] monitoring fds[%s] nMaxSD[%d]", fds.c_str(), nMaxSD);
     sSocketListUpdated = false;
     return nMaxSD;
 }
@@ -575,10 +587,16 @@ void ImsMediaSocket::SocketMonitorThread()
 
         if (res == -1)
         {
-            IMLOGE0("[SocketMonitorThread] select function Error!!");
+            IMLOGE1("[SocketMonitorThread] select function Error!! errno[%d]", errno);
         }
         else
         {
+            static int nSelectLogCounter = 0;
+            if (++nSelectLogCounter % 10 == 0)
+            {
+                IMLOGI3("[SocketMonitorThread] select res[%d] nMaxSD[%d] loops[%d]", res, nMaxSD,
+                        nSelectLogCounter);
+            }
             ReadDataFromSocket(&TmpReadfds);
         }
     }
