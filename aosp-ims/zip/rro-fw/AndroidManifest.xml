<?xml version="1.0" encoding="utf-8"?>
<!-- Device-level VoLTE admit: ImsManager.isVolteEnabledByPlatform() ANDs
     this framework bool with carrier_volte_available_bool; LineageOS ships
     it false on joan, which hides the VoLTE toggle and sends every dial to
     CS. Also admits Wi-Fi calling and names the AOSP IWLAN and QNS
     services; the values file says why each is set. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.imsstack.rro.framework"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="35" />
    <application android:hasCode="false" />
    <overlay android:targetPackage="android"
        android:priority="3"
        android:isStatic="true" />
</manifest>
