# AP-side IMS SIP user agent.
#
# joan's MPSS has no QMI IMSS, so SIP lives on the application processor.
# This runs in its own joan_ims domain (sepolicy/joan_ims.te) rather than
# borrowing netmgrd, and installs to system_ext rather than /system.
# The out-of-tree recovery zip has to do both of those things because a
# sideloaded install cannot add a policy; a ROM build must not.

service joan-ims /system_ext/bin/joan-ims-ua register
    class late_start
    user root
    group radio inet system
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:joan_ims:s0

on property:sys.boot_completed=1
    start joan-ims
