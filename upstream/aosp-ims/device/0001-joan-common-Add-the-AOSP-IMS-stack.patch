diff --git a/rootdir/system_ext/etc/default-permissions/default-permissions-ims.xml b/rootdir/system_ext/etc/default-permissions/default-permissions-ims.xml
new file mode 100644
index 0000000..f1e85ff
--- /dev/null
+++ b/rootdir/system_ext/etc/default-permissions/default-permissions-ims.xml
@@ -0,0 +1,35 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Copyright (C) 2026 The LineageOS Project
+
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!--
+    Runtime permissions for the IMS stack, granted on first boot and after
+    each system update. Telephony also grants some of these when it binds
+    the services; granting them here does not depend on that ordering.
+-->
+<exceptions>
+    <!-- ImsMedia (phone uid): the microphone and camera for call media. -->
+    <exception package="com.android.telephony.imsmedia">
+        <permission name="android.permission.RECORD_AUDIO" fixed="false"/>
+        <permission name="android.permission.CAMERA" fixed="false"/>
+    </exception>
+    <!-- ImsStack: phone state; location for emergency calls (P-A-N-I). -->
+    <exception package="com.android.imsstack">
+        <permission name="android.permission.READ_PHONE_STATE" fixed="false"/>
+        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
+        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
+        <permission name="android.permission.ACCESS_BACKGROUND_LOCATION" fixed="false"/>
+    </exception>
+    <!-- IWLAN reads the SIM and the country to select an ePDG. -->
+    <exception package="com.google.android.iwlan">
+        <permission name="android.permission.READ_PHONE_STATE" fixed="false"/>
+        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
+        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
+    </exception>
+    <!-- QNS reads the phone state to choose between LTE and Wi-Fi. -->
+    <exception package="com.android.telephony.qns">
+        <permission name="android.permission.READ_PHONE_STATE" fixed="false"/>
+    </exception>
+</exceptions>
